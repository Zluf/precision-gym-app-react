{
  "compilerOptions": {
    "target": "ES6",
    "outDir": "./dist", // Specify output directory for compiled files
    "rootDir": "./src", // Specify the root directory of input files
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true, // ← let TS parse .js/.jsx files
    "checkJs": false, // ← don’t report errors inside them (set true later)
    "isolatedModules": true // ← keeps Babel/esbuild/SWC happy
  },
  "exclude": ["node_modules", "dist", "vite.config.ts"] // Exclude the output directory and vite.config.ts to prevent overwriting
}
